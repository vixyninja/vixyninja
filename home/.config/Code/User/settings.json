{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/bower_components/**": true,
    "**/vendor/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.build/**": true,
    "**/out/**": true,
    "**/target/**": true,
    "**/coverage/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.svelte-kit/**": true,
    "**/.astro/**": true,
    "**/.turbo/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/tmp/**": true,
    "**/.terraform/**": true,
    "**/.godot/**": true,
    "**/go/pkg/mod/**": true,
    "**/.gradle/**": true,
    "**/.idea/**": true
  },
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "js/ts.tsserver.maxMemory": 2048,
  "editor.minimap.renderCharacters": false,
  "workbench.startupEditor": "none",
  "workbench.editor.labelFormat": "default",
  "workbench.list.smoothScrolling": true,
  "workbench.editor.wrapTabs": true,
  "workbench.editor.tabSizing": "fixed",
  "workbench.editor.defaultBinaryEditor": "default",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.colorTheme": "Dark+",
  "workbench.tree.stickyScrollMaxItemCount": 4,
  "workbench.tree.indent": 4,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.expandMode": "doubleClick",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.md": "default"
  },
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "window.title": "${dirty}${activeEditorMedium}${separator}${rootName}${separator}",
  "window.titleSeparator": " 🎯 ",
  "window.zoomLevel": -0.5,
  "editor.fontFamily": "Monaco",
  "editor.fontSize": 14.5,
  "editor.lineHeight": 16.5,
  "editor.letterSpacing": 0,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.rulers": [
    120
  ],
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 120,
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "gutter",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.minimap.enabled": true,
  "editor.glyphMargin": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.largeFileOptimizations": true,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 15,
  "editor.smoothScrolling": true,
  "editor.mouseWheelScrollSensitivity": 1,
  "editor.mouseWheelZoom": false,
  "editor.hover.enabled": "on",
  "editor.hover.sticky": true,
  "editor.hover.delay": 500,
  "editor.codeLensFontFamily": "Monaco",
  "editor.codeLensFontSize": 16,
  "editor.inlayHints.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.snippetSuggestions": "bottom",
  "editor.suggestSelection": "first",
  "editor.suggest.preview": true,
  "editor.suggest.matchOnWordStartOnly": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.snippetsPreventQuickSuggestions": true,
  "editor.suggest.localityBonus": true,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.wordBasedSuggestions": "matchingDocuments",
  "editor.inlineSuggest.enabled": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/vendor": true,
    "**/coverage": true,
    "**/dist": true,
    "**/build": true,
    "**/.build": true,
    "**/out": true,
    "**/target": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.svelte-kit": true,
    "**/*.lock": true,
    "**/go.sum": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true
  },
  "files.defaultLanguage": "{activeEditorLanguage}",
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "git.confirmSync": false,
  "git.replaceTagsWhenPull": true,
  "git.autofetch": false,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "Monaco",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.drawBoldTextInBrightColors": false,
  "terminal.integrated.enableFileLinks": "on",
  "terminal.integrated.initialHint": false,
  "debug.console.wordWrap": true,
  "debug.inlineValues": "on",
  "debug.console.fontFamily": "Monaco",
  "debug.console.fontSize": 16,
  "debug.console.lineHeight": 17.5,
  "gopls": {
    "formatting.gofumpt": true
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "go.buildFlags": [
    "-tags=wireinject"
  ],
  "go.toolsManagement.autoUpdate": false,
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.indexing": true,
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv"
  ],
  "cSpell.enabled": true,
  "cSpell.language": "en,vi",
  "cSpell.enabledFileTypes": {
    "*": false,
    "markdown": true,
    "plaintext": true,
    "go": true,
    "python": true,
    "typescript": true,
    "javascript": true
  },
  "cSpell.userWords": [
    "bycryptjs",
    "cloudinary",
    "metatype",
    "typeorm",
    "vixyninja"
  ],
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://turborepo.com": true,
    "https://www.schemastore.org/": true
  },
  "material-icon-theme.folders.color": "#42a5f5",
  "material-icon-theme.activeIconPack": "angular",
  "material-icon-theme.files.color": "#42a5f5",
  "material-icon-theme.opacity": 1,
  "material-icon-theme.saturation": 1,
  "material-icon-theme.hidesExplorerArrows": false,
  "gitlens.views.branches.files.layout": "list",
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command"
  ],
  "gitlens.views.repositories.showStashes": true,
  "makefile.configureOnOpen": false,
  "claudeCode.preferredLocation": "panel",
}
